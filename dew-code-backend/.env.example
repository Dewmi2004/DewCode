# ─── Server ───────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─── MongoDB ──────────────────────────────────────────────
# Use MongoDB Atlas in production — Render's filesystem is ephemeral and
# there's nowhere to run a persistent local Mongo instance.
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/dewcode

# ─── JWT ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# ─── Cookie ───────────────────────────────────────────────
COOKIE_SECRET=

# ─── Frontend ─────────────────────────────────────────────
# Your Vercel domain(s). Comma-separate if you have more than one
# (e.g. production domain + a preview domain).
# Example: https://dewcode.vercel.app,https://dewcode-git-main.vercel.app
CLIENT_URL=https://your-app.vercel.app

# ─── Bcrypt ───────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ─── AI (Ollama) ────────────────────────────────────────────
# Only reachable while your tunnel (ngrok/Cloudflare) and local Ollama are
# both running — see deployment notes. Update this value whenever the
# tunnel URL changes.
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_URL=https://your-ngrok-subdomain.ngrok-free.app

# ─── PayHere (Free → Plus upgrade) ─────────────────────────
# Get these from https://www.payhere.lk (live) or
# https://sandbox.payhere.lk (test mode)
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_PLUS_PRICE=
# Must be your live, public Render backend URL so PayHere's servers can
# reach the notify webhook — e.g. https://dewcode-backend.onrender.com
API_PUBLIC_URL=https://your-backend.onrender.com
