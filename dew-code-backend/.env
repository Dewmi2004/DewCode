# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB ──────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/dewcode
# Atlas:  mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/dewcode
MONGODB_URI=mongodb://localhost:27017/dew_code

# ─── JWT ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=fca584de-793c-4ec2-8963-82c9b7cb5894
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=458abab8-a54d-4616-9b12-9583714be243
JWT_REFRESH_EXPIRES_IN=30d

# ─── Cookie ───────────────────────────────────────────────
COOKIE_SECRET=99c95c0b-745d-4d6a-92de-09781d8adf6d

# ─── Frontend ─────────────────────────────────────────────
CLIENT_URL=http://localhost:3000

# ─── Bcrypt ───────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
# ─── set to true to sandbox in Docker ─────────────────────────

TERMINAL_USE_DOCKER=true
WORKSPACE_DIR=C:\dewcode-workspace

OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_URL=http://localhost:11434 


 
# ─── PayHere (Free → Plus upgrade) ─────────────────────────
# Get these from https://www.payhere.lk (live) or
# https://sandbox.payhere.lk (test mode — use this while developing)
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=1234608
PAYHERE_MERCHANT_SECRET=MTYwMzM4Mzg1NTEyNDI5MzI5MTI1ODExMjM3MjEzNDIwOTk0NzE4
PAYHERE_PLUS_PRICE=1500
# Must be a publicly reachable URL for PayHere's notify webhook.
# Use a tool like ngrok while developing locally, e.g. https://abcd1234.ngrok.io
API_PUBLIC_URL=http://localhost:5000
 
# ─── PayHere (Plus plan upgrade) ───────────────────────────
# Get these from your PayHere dashboard: Settings > Domains & Credentials.
# Use the Sandbox dashboard (sandbox.payhere.lk) while testing.
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=1234608
PAYHERE_MERCHANT_SECRET=MTYwMzM4Mzg1NTEyNDI5MzI5MTI1ODExMjM3MjEzNDIwOTk0NzE4
PAYHERE_PLUS_PRICE=1500
